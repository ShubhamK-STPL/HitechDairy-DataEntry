{
  "name": "hitechdairy-dataentry",
  "private": true,
  "version": "1.0.0",
  "type": "commonjs",
  "scripts": {
    "test": "playwright test",
    "test:serial": "playwright test --workers=1",
    "test:headed": "playwright test --headed",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:debugger": "node scripts/debugger.mjs",
    "ai:test": "node scripts/test-groq-intelligence.mjs",
    "report:show": "playwright show-report",
    "report:open": "node scripts/open-report.mjs",
    "report:sync": "tsx src/onboarding.ts --report-only",
    "report:labs": "node scripts/open-report.mjs --labs",
    "testcases:generate": "node scripts/generate-testcases.mjs",
    "session:clear": "node -e \"const fs=require('fs'); ['storageState.json'].forEach(f => { if(fs.existsSync(f)) { fs.unlinkSync(f); console.log('Cleared session:', f); } else { console.log('No session to clear'); } });\"",
    "auth:setup": "playwright test tests/auth.setup.ts --project=setup --headed",
    "login": "node scripts/login-and-save-session.mjs",
    "login:empty": "node scripts/login-and-save-session.mjs --no-prefill",
    "auth:login": "node scripts/login-and-save-session.mjs",
    "supplier:login": "node scripts/login-and-save-session.mjs",
    "supplier:login:empty": "node scripts/login-and-save-session.mjs --no-prefill",
    "supplier:validate": "node scripts/validate-excel.mjs",
    "supplier:import": "node scripts/import-supplier-records.mjs",
    "supplier:import:headed": "node scripts/import-supplier-records.mjs --headed",
    "supplier:sample": "node scripts/create-sample-excel.mjs",
    "supplier:test": "playwright test tests/supplier-registration.spec.ts --headed",
    "supplier:debug": "node scripts/debugger.mjs tests/supplier-registration.spec.ts",
    "product:sample": "node scripts/create-sample-product-excel.mjs",
    "product:validate": "node scripts/validate-product-excel.mjs",
    "product:import": "node scripts/import-product-records.mjs",
    "product:import:headed": "node scripts/import-product-records.mjs --headed",
    "product:test": "playwright test tests/product-registration.spec.ts --headed",
    "product:debug": "node scripts/debugger.mjs tests/product-registration.spec.ts",
    "customer:sample": "node scripts/create-sample-customer-excel.mjs",
    "customer:validate": "node scripts/validate-customer-excel.mjs",
    "customer:import": "node scripts/import-customer-records.mjs",
    "customer:import:headed": "node scripts/import-customer-records.mjs --headed",
    "customer:test": "playwright test tests/customer-registration.spec.ts --headed",
    "customer:debug": "node scripts/debugger.mjs tests/customer-registration.spec.ts",
    "farmer:sample": "node scripts/create-sample-farmer-excel.mjs",
    "farmer:verify": "tsx scripts/verify-farmer-records.ts",
    "farmer:validate": "node scripts/validate-farmer-excel.mjs",
    "farmer:import": "node scripts/import-farmer-records.mjs",
    "farmer:import:headed": "node scripts/import-farmer-records.mjs --headed",
    "farmer:test": "playwright test tests/farmer-registration.spec.ts --headed",
    "farmer:debug": "node scripts/debugger.mjs tests/farmer-registration.spec.ts",
    "variant:sample": "node scripts/create-sample-product-variant-excel.mjs",
    "variant:validate": "node scripts/validate-product-variant-excel.mjs",
    "variant:import": "node scripts/import-product-variant-records.mjs",
    "variant:import:headed": "node scripts/import-product-variant-records.mjs --headed",
    "variant:test": "playwright test tests/product-variant.spec.ts --headed",
    "variant:test:v2": "playwright test tests/product-variantV2.spec.ts --headed",
    "variant:debug": "node scripts/debugger.mjs tests/product-variant.spec.ts",
    "invoice:sample": "node scripts/create-sample-sales-invoice-excel.mjs",
    "invoice:test": "playwright test tests/sales-invoice.spec.ts --headed",
    "tx:test": "playwright test tests/account-transaction.spec.ts --headed",
    "account:test": "playwright test tests/account-transaction.spec.ts --headed",
    "excel:merge": "node scripts/merge-all-excel-templates.mjs",
    "master:merge": "node scripts/merge-all-excel-templates.mjs",
    "onboard": "tsx src/onboarding.ts",
    "onboard:variants:v2": "tsx src/onboarding.ts --module=VariantsV2",
    "onboard:sequential": "tsx src/onboarding.ts --sequential",
    "onboard:parallel": "tsx src/onboarding.ts --parallel --workers=2",
    "ui": "tsx src/ui/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.5",
    "reporting-labs": "^0.6.24",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  }
}
