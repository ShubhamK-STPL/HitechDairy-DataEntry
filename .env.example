# ==============================================================================
# HitechDairy Configuration Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# 1. Target Portal URLs (BASE_URL + Page Paths)
BASE_URL=https://webuat.hitechdairy.in
LOGIN_PAGE=/login
SUPPLIER_ENTRY_PAGE=/procurement/masters/add-supplier
PRODUCT_ENTRY_PAGE=/general/master/product
CUSTOMER_ENTRY_PAGE=/procurement/masters/customer-register
CUSTOMER_LIST_PAGE=/procurement/masters/customer-list
FARMER_ENTRY_PAGE=/procurement/masters/add-farmer
FARMER_LIST_PAGE=/procurement/masters/farmer-registration
PRODUCT_VARIANT_PAGE=/inventory-management/master/product-variant

# 2. Authentication, Financial Year & User Role
ADMIN_USERNAME=your_username_here
ADMIN_PASSWORD=your_password_here
FINANCIAL_YEAR=2026-2027
# Role Level: Superadmin | orglevel | unitlevel
USER_ROLE=Superadmin

# 3. Multi-Tenant Scoping (Optional: used only if user role requires org/unit selection and Excel omits it)
DEFAULT_ORGANIZATION="Shewale Dairy"
DEFAULT_UNIT="Shewale Dairy"
DEFAULT_PRODUCT_IMAGE_PATH=test-data/Upload_08082026235640725.png

# (Note: All record fields like Category, Gender, Billing Type, Ratecard Group,
#  Route, Variant Type, Tracking, Mensuration, Taxes, and GST are taken directly
#  from the Excel spreadsheet. No hardcoding.)

# 4. Storage & Session State
STORAGE_STATE_PATH=storageState.json

# 5. Excel Data Ingestion
EXCEL_PATH=test-data/suppliers_template.xlsx
EXCEL_SHEET_NAME=Suppliers
PRODUCT_EXCEL_PATH=test-data/products_template.xlsx
PRODUCT_EXCEL_SHEET=Products
CUSTOMER_EXCEL_PATH=test-data/customers_template.xlsx
CUSTOMER_EXCEL_SHEET=Customers
FARMER_EXCEL_PATH=test-data/farmers_template.xlsx
FARMER_EXCEL_SHEET=Farmers
PRODUCT_VARIANT_EXCEL_PATH=test-data/product_variants_template.xlsx
PRODUCT_VARIANT_EXCEL_SHEET=Variants

# 6. Output & Reports Directories
REPORTS_DIR=docs
AUDIT_DIR=docs
SCREENSHOTS_DIR=test-results

# 7. Execution & Timing Settings
SLOW_MO=50
DEFAULT_TIMEOUT=30000
NAVIGATION_TIMEOUT=45000
ACTION_TIMEOUT=15000
LOGIN_TIMEOUT=300000

# 8. AI Intelligence (Groq LLM for Autonomous Debugging & Failure Diagnostics)
# Set USE_AI_INTELLIGENCE=true to engage Groq AI, or false to run purely rule-based
USE_AI_INTELLIGENCE=true
Groq_API_Key=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
AI_REPORTS_DIR=reports/ai-intelligence
